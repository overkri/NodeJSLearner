# Copy to .env. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
HTTP_BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ledger-api
KAFKA_GROUP_ID=ledger-consumer
KAFKA_TRANSFER_TOPIC=ledger.transfers.v1

# Local development/test verification key. Replace outside the course.
JWT_ISSUER=https://ledger.local/
JWT_AUDIENCE=ledger-api
JWT_PUBLIC_KEY_FILE=./test/fixtures/jwt-public.pem
JWT_PRIVATE_KEY_FILE=./test/fixtures/jwt-private.pem

IDEMPOTENCY_TTL_SECONDS=86400
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Integration tests are skipped unless explicitly enabled.
RUN_INTEGRATION_TESTS=false
