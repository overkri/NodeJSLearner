{
  "name": "nodejs-learner",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Ledger API course: Node.js backend for Java/Spring engineers",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "node --import tsx scripts/run-tests.ts",
    "test:exercises": "node --import tsx scripts/run-tests.ts --exercises --strict",
    "test:integration": "node --import tsx scripts/run-tests.ts --integration",
    "verify:solutions": "node --import tsx scripts/verify-solutions.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli:inspect": "node --import tsx src/cli/main.ts",
    "dev:http": "node --import tsx src/transport/http/main.ts",
    "dev:nest": "node --import tsx src/transport/nest/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-node": "12.4.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "kafkajs": "2.2.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.4.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
